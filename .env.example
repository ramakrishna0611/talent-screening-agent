# Copy to .env. Never commit .env.
GROQ_API_KEY=your-groq-key
# Candidate emails (shortlist / reject). Leave empty to store emails in the outbox without sending.
# Use a dedicated test Gmail with 2-Step Verification and an App password (myaccount.google.com/apppasswords).
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
